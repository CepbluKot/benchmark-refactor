{
  "celery": {
    "workers": 4,
    "threads_per_worker": 2
  },
  "connections_file": "connections.example.json",
  "rule_banks_file": "rule_banks.example.json",
  "benchmarks": [
    {
      "id": "bench_default_rules_auto_discovery",
      "connection_id": "prod_ch",
      "strategy": "types_strategy",
      "column_rules_mode": "global_bank_only",
      "index_rules_mode": "global_bank_only",
      "databases": "*",
      "tables": "*",
      "insert_operations_count": 3,
      "insert_rows_per_operation_limit": 1000000,
      "source_insert_rows_per_operation_limit": 700000,
      "insert_rows_per_operation_limits": {
        "types": 1500000
      },
      "queries": {
        "mode": "auto",
        "auto_like_on_measured_columns": true,
        "auto_like_sample_rows_per_column": 20,
        "auto_like_min_token_length": 3,
        "auto_like_max_token_length": 24,
        "auto_select_limit": 10
      },
      "scoring": {
        "mode": "expression",
        "variables": {
          "baseline_median_read_bytes": "medians.source_select_read_bytes",
          "test_median_read_bytes": "medians.tested_select_read_bytes",
          "select_ratio": "safe_div(baseline_median_read_bytes, test_median_read_bytes, 1.0)",
          "compression_ratio": "safe_div(source_size_bytes, tested_size_bytes, 1.0)"
        },
        "expression": "exp(0.75 * ln(select_ratio) + 0.25 * ln(compression_ratio))"
      }
    },
    {
      "id": "bench_mixed_selectors",
      "connection_id": "prod_ch",
      "strategy": "combined_strategy",
      "column_rules_mode": "global_bank_with_inline_priority",
      "index_rules_mode": "global_bank_with_inline_priority",
      "tables": {
        "analytics": [
          "user_events"
        ],
        "marketing": "*"
      },
      "insert_operations_count": 5,
      "insert_rows_per_operation_limit": 5000000,
      "source_insert_rows_per_operation_limit": 1200000,
      "insert_rows_per_operation_limits": {
        "combined": 5500000,
        "sequential": 1200000
      },
      "global_rules": {
        "rule_bank": "aggressive_zstd"
      },
      "queries": {
        "mode": "auto",
        "auto_like_on_measured_columns": true,
        "auto_like_sample_rows_per_column": 20,
        "auto_like_min_token_length": 3,
        "auto_like_max_token_length": 24,
        "auto_select_limit": 10
      },
      "table_rules": [
        {
          "database": "analytics",
          "table": "user_events",
          "insert_operations_count": 2,
          "insert_rows_per_operation_limit": 250000,
          "source_insert_rows_per_operation_limit": 180000,
          "insert_rows_per_operation_limits": {
            "types": 300000,
            "indexes": 120000
          },
          "strategy": "sequential_phased_topn_strategy",
          "rules": {
            "column_rules": [
              {
                "by_name": "revenue",
                "by_type": "Nullable(Decimal(18,4))",
                "types": [
                  "Nullable(Decimal(18,4))",
                  "Nullable(Float64)"
                ],
                "codecs": [
                  "CODEC(ZSTD(1))",
                  "CODEC(ZSTD(5))"
                ]
              }
            ]
          },
          "queries": {
            "mode": "auto",
            "auto_like_on_measured_columns": true,
            "auto_like_sample_rows_per_column": 20,
            "auto_like_min_token_length": 3,
            "auto_like_max_token_length": 24,
            "auto_select_limit": 10
          }
        }
      ],
      "scoring": {
        "mode": "expression",
        "variables": {
          "baseline_median_read_bytes": "medians.source_select_read_bytes",
          "test_median_read_bytes": "medians.tested_select_read_bytes",
          "select_ratio": "safe_div(baseline_median_read_bytes, test_median_read_bytes, 1.0)",
          "compression_ratio": "safe_div(source_size_bytes, tested_size_bytes, 1.0)"
        },
        "expression": "exp(0.75 * ln(select_ratio) + 0.25 * ln(compression_ratio))"
      }
    }
  ]
}
