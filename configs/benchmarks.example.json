{
  "benchmarks": [
    {
      "id": "bench_mixed_selectors",
      "connection_id": "prod_ch",
      "strategy": "combined_strategy",
      "column_rules_mode": "inline_only",
      "index_rules_mode": "inline_only",
      "column_order_mode": "compressed_size_desc",
      "test_database": "benchmark_tmp",
      "tables": {
        "analytics": [
          "user_events"
        ]
      },
      "insert_operations_count": 5,
      "insert_rows_per_operation_limit": 5000000,
      "source_insert_rows_per_operation_limit": 1200000,
      "index_granularity_values": [
        8192,
        16384
      ],
      "scoring": {
        "mode": "expression",
        "expression": "pow(safe_div(medians.source_insert_time_ms, medians.tested_insert_time_ms, 1.0) * safe_div(medians.source_select_time_ms, medians.tested_select_time_ms, 1.0) * safe_div(source_size_bytes, tested_size_bytes, 1.0), 1 / 3)",
        "on_error_score": -1.0
      },
      "insert_rows_per_operation_limits": {
        "types": 900000,
        "indexes": 350000,
        "combined": 5500000,
        "sequential": 1200000
      },
      "global_rules": {
        "rule_bank": "clickhouse_universal_baseline"
      },
      "queries": {
        "mode": "auto_with_manual",
        "test_queries": [
          {
            "query_id": "q_count_last_day",
            "query": "SELECT count() FROM {table} WHERE event_time >= now() - INTERVAL 1 DAY /* benchmark={benchmark_id} */",
            "cache_mode": "warm",
            "select_operations_count": 5
          }
        ]
      },
      "table_rules": [
        {
          "database": "analytics",
          "table": "user_events",
          "test_database": "benchmark_tmp_user_events",
          "insert_operations_count": 22,
          "sequential_types_top_n_for_indexes": 3,
          "insert_rows_per_operation_limit": 250000,
          "source_insert_rows_per_operation_limit": 180000,
          "insert_rows_per_operation_limits": {
            "types": 300000,
            "indexes": 120000,
            "sequential": 180000
          },
          "strategy": "sequential_phased_topn_strategy",
          "rules": {
            "column_rules": [
              {
                "by_name": "revenue",
                "by_type": "Nullable(Decimal(18,4))",
                "types": [
                  "Nullable(Decimal(18,4))",
                  "Nullable(Float64)"
                ],
                "codecs": [
                  "CODEC(ZSTD(1))",
                  "CODEC(ZSTD(5))"
                ]
              }
            ],
            "index_rules": [
              {
                "by_type": "Nullable(Decimal(18,4))",
                "auto_generate_indexes": true,
                "indexes": [
                  {
                    "type": "bloom_filter(0.01)",
                    "granularity": [
                      228,
                      256
                    ],
                    "index_granularity_values": [
                      8192
                    ]
                  },
                  {
                    "type": "bloom_filter(0.01)",
                    "granularity": 123,
                    "index_granularity_values": [
                      16384
                    ]
                  }
                ]
              }
            ]
          },
          "queries": {
            "mode": "manual",
            "test_queries": [
              {
                "query_id": "q_revenue_sum",
                "query": "SELECT sum(revenue) FROM {table} /* benchmark={benchmark_id} */",
                "cache_mode": "warm",
                "select_operations_count": 2,
                "warmup_queries": [
                  "SELECT count() FROM {table}"
                ]
              }
            ]
          }
        }
      ]
    },
