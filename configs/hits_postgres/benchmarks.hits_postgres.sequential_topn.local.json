{
  "benchmarks": [
    {
      "id": "bench_hits_postgres_sequential_topn",
      "connection_id": "local_ch_hits",
      "strategy": "sequential_topn_strategy",
      "column_rules_mode": "inline_only",
      "index_rules_mode": "inline_only",
      "column_order_mode": "compressed_size_desc",
      "databases": [
        "default"
      ],
      "tables": {
        "default": [
          "hits_postgres",
          "messages"
        ]
      },
      "test_database": "benchmark_tmp",
      "insert_operations_count": 10,
      "sequential_types_top_n_for_indexes": 3,
      "scoring": {
        "mode": "expression",
        "expression": "pow(safe_div(medians.source_insert_time_ms, medians.tested_insert_time_ms, 1.0) * safe_div(medians.source_select_time_ms, medians.tested_select_time_ms, 1.0) * safe_div(source_size_bytes, tested_size_bytes, 1.0), 1 / 3)",
        "on_error_score": -1.0
      },
      "max_benchmarks_limits": {
        "types": 30,
        "indexes": 30,
        "sequential": 5
      },
      "source_insert_rows_per_operation_limits": {
        "sequential": 300000
      },
      "insert_rows_per_operation_limits": {
        "types": 100000,
        "indexes": 100000,
        "sequential": 100000
      },
      "global_rules": {
        "column_rules": [
          {
            "by_type": "String",
            "auto_generate_alternatives": true,
            "auto_compressions_datatype": "String",
            "types": [
              "String"
            ]
          }
        ],
        "index_rules": [
          {
            "by_name": "user_id",
            "by_type": "Int32",
            "auto_generate_indexes": true,
            "indexes": [
              {
                "type": "set(512)",
                "granularity": 2,
                "index_granularity_values": [
                  8192,
                  16384
                ]
              },
              {
                "type": "bloom_filter(0.01)",
                "granularity": 2,
                "index_granularity_values": [
                  8192
                ]
              }
            ]
          },
          {
            "by_name": "country",
            "by_type": "String",
            "auto_generate_indexes": true,
            "indexes": [
              {
                "type": "set(128)",
                "granularity": 2,
                "index_granularity_values": [
                  16384
                ]
              },
              {
                "type": "bloom_filter(0.01)",
                "granularity": 2,
                "index_granularity_values": [
                  8192,
                  16384
                ]
              }
            ]
          },
          {
            "by_name": "device_type",
            "by_type": "String",
            "auto_generate_indexes": true,
            "indexes": [
              {
                "type": "ngrambf_v1(3, 256, 2, 0)",
                "granularity": 2,
                "index_granularity_values": [
                  8192
                ]
              }
            ]
          }
        ]
      },
      "table_rules": [
        {
          "database": "default",
          "table": "messages",
          "rules": {
            "index_rules": [
              {
                "by_name": "msg",
                "by_type": "String",
                "indexes": [
                  {
                    "type": "ngrambf_v1(3, 256, 2, 0)",
                    "granularity": 2,
                    "index_granularity_values": [
                      8192
                    ]
                  }
                ]
              }
            ]
          },
          "queries": {
            "mode": "manual",
            "test_queries": [
              {
                "query_id": "q_msg_count_all",
                "query": "SELECT count() FROM {table} /* benchmark={benchmark_id} */",
                "cache_mode": "warm",
                "select_operations_count": 3,
                "warmup_queries": [
                  "SELECT count() FROM {table}"
                ]
              },
              {
                "query_id": "q_msg_prefix_top100",
                "query": "SELECT msg, count() FROM {table} WHERE msg LIKE 'a%' GROUP BY msg ORDER BY count() DESC LIMIT 100",
                "cache_mode": "warm",
                "select_operations_count": 3,
                "warmup_queries": [
                  "SELECT count() FROM {table}"
                ]
              }
            ]
          }
        }
      ],
      "queries": {
        "mode": "manual",
        "test_queries": [
          {
            "query_id": "q_count_all",
            "query": "SELECT count() FROM {table} /* benchmark={benchmark_id} */",
            "cache_mode": "warm",
            "select_operations_count": 3,
            "warmup_queries": [
              "SELECT count() FROM {table}"
            ]
          },
          {
            "query_id": "q_country_top100",
            "query": "SELECT country, count() FROM {table} GROUP BY country ORDER BY count() DESC LIMIT 100",
            "cache_mode": "warm",
            "select_operations_count": 3,
            "warmup_queries": [
              "SELECT count() FROM {table}"
            ]
          },
          {
            "query_id": "q_mobile_revenue_sum",
            "query": "SELECT sum(revenue) FROM {table} WHERE device_type = 'mobile'",
            "cache_mode": "warm",
            "select_operations_count": 3,
            "warmup_queries": [
              "SELECT count() FROM {table}"
            ]
          },
          {
            "query_id": "q_user_revenue_top100",
            "query": "SELECT user_id, sum(revenue) FROM {table} GROUP BY user_id ORDER BY sum(revenue) DESC LIMIT 100",
            "cache_mode": "warm",
            "select_operations_count": 3,
            "warmup_queries": [
              "SELECT count() FROM {table}"
            ]
          }
        ]
      }
    }
  ]
}
