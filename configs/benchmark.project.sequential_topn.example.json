{
  "celery": {
    "workers": 4,
    "threads_per_worker": 2
  },
  "connections_file": "connections.example.json",
  "rule_banks_file": "rule_banks.example.json",
  "benchmarks": [
    {
      "id": "bench_sequential_topn",
      "connection_id": "prod_ch",
      "strategy": "sequential_phased_topn_strategy",
      "databases": [
        "analytics"
      ],
      "tables": [
        "user_events",
        "partner_stats"
      ],
      "insert_operations_count": 20,
      "sequential_types_top_n_for_indexes": 2,
      "insert_rows_per_operation_limit":  20000,
      "source_insert_rows_per_operation_limit": 900000,
      "insert_rows_per_operation_limits": {
        "types": 2500000,
        "indexes": 800000
      },
      "global_rules": {
        "column_rules": [
          {
            "by_type": "UInt64",
            "types": [
              "UInt64",
              "UInt32"
            ],
            "codecs": [
              "CODEC(Delta(8), LZ4)",
              "CODEC(T64, ZSTD(1))"
            ]
          },
          {
            "by_type": "UInt32",
            "types": [
              "UInt32",
              "UInt16"
            ],
            "codecs": [
              "CODEC(Delta(4), LZ4)",
              "CODEC(T64, ZSTD(1))"
            ]
          },
          {
            "by_type": "DateTime",
            "codecs": [
              "CODEC(DoubleDelta, LZ4)",
              "CODEC(DoubleDelta, ZSTD(1))"
            ]
          }
        ],
        "index_rules": [
          {
            "by_type": "UInt64",
            "indexes": [
              {
                "type": "minmax",
                "granularity": [
                  4,
                  8,
                  16
                ]
              },
              {
                "type": "bloom_filter(0.01)",
                "granularity": [
                  4,
                  8,
                  16
                ]
              }
            ]
          },
          {
            "by_type": "UInt32",
            "indexes": [
              {
                "type": "minmax",
                "granularity": [
                  4,
                  8,
                  16
                ]
              },
              {
                "type": "bloom_filter(0.01)",
                "granularity": [
                  4,
                  8,
                  16
                ]
              }
            ]
          },
          {
            "by_type": "DateTime",
            "indexes": [
              {
                "type": "minmax",
                "granularity": [
                  4,
                  8,
                  16
                ]
              }
            ]
          }
        ]
      },
      "queries": {
        "mode": "auto",
        "auto_like_on_measured_columns": true,
        "auto_like_sample_rows_per_column": 20,
        "auto_like_min_token_length": 3,
        "auto_like_max_token_length": 24,
        "auto_select_limit": 10
      },
      "table_rules": [
        {
          "database": "analytics",
          "table": "user_events",
          "sequential_types_top_n_for_indexes": 1,
          "insert_operations_count": 12,
          "insert_rows_per_operation_limit":  20000,
          "source_insert_rows_per_operation_limit": 250000,
          "insert_rows_per_operation_limits": {
            "types": 700000,
            "indexes": 250000
          },
          "rules": {
            "column_order": {
              "user_id": 1,
              "event_time": 2
            }
          }
        },
        {
          "database": "analytics",
          "table": "partner_stats",
          "column_order_mode": "compressed_size_desc"
        }
      ],
      "scoring": {
        "mode": "expression",
        "variables": {
          "baseline_median_read_bytes": "medians.source_select_read_bytes",
          "test_median_read_bytes": "medians.tested_select_read_bytes",
          "select_ratio": "safe_div(baseline_median_read_bytes, test_median_read_bytes, 1.0)",
          "compression_ratio": "safe_div(source_size_bytes, tested_size_bytes, 1.0)"
        },
        "expression": "exp(0.75 * ln(select_ratio) + 0.25 * ln(compression_ratio))"
      }
    }
  ]
}
