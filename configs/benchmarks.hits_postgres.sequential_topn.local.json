{
  "benchmarks": [
    {
      "id": "bench_hits_postgres_sequential_topn",
      "connection_id": "local_ch_hits",
      "strategy": "sequential_topn_strategy",
      "column_rules_mode": "inline_only",
      "index_rules_mode": "inline_only",
      "column_order_mode": "compressed_size_desc",
      "databases": [
        "default"
      ],
      "tables": {
        "default": [
          "hits_postgres"
        ]
      },
      "test_database": "benchmark_tmp",
      "insert_operations_count": 3,
      "sequential_types_top_n_for_indexes": 3,
      "scoring": {
        "mode": "builtin"
      },
      "insert_rows_per_operation_limit": 300000,
      "source_insert_rows_per_operation_limit": 180000,
      "insert_rows_per_operation_limits": {
        "types": 300000,
        "indexes": 150000
      },
      "global_rules": {
        "column_rules": [
          {
            "by_type": "String",
            "types": [
              "String",
              "LowCardinality(String)"
            ],
            "codecs": [
              "CODEC(LZ4)",
              "CODEC(ZSTD(1))"
            ]
          }
        ],
        "index_rules": [
          {
            "by_name": "country",
            "by_type": "String",
            "indexes": [
              {
                "type": "bloom_filter(0.01)",
                "granularity": 2
              }
            ]
          }
        ]
      },
      "queries": {
        "mode": "manual",
        "test_queries": [
          {
            "query": "SELECT count() FROM {table} WHERE event_date >= toDate('2014-01-01')",
            "cache_mode": "warm",
            "select_operations_count": 3,
            "warmup_queries": [
              "SELECT count() FROM {table}"
            ]
          },
          {
            "query": "SELECT country, count() FROM {table} WHERE event_date >= toDate('2014-01-01') GROUP BY country ORDER BY count() DESC LIMIT 100",
            "cache_mode": "warm",
            "select_operations_count": 3,
            "warmup_queries": [
              "SELECT count() FROM {table}"
            ]
          },
          {
            "query": "SELECT sum(revenue) FROM {table} WHERE device_type = 'mobile'",
            "cache_mode": "warm",
            "select_operations_count": 3,
            "warmup_queries": [
              "SELECT count() FROM {table}"
            ]
          },
          {
            "query": "SELECT user_id, sum(revenue) FROM {table} WHERE event_date >= toDate('2014-01-01') GROUP BY user_id ORDER BY sum(revenue) DESC LIMIT 100",
            "cache_mode": "warm",
            "select_operations_count": 3,
            "warmup_queries": [
              "SELECT count() FROM {table}"
            ]
          }
        ]
      }
    }
  ]
}
