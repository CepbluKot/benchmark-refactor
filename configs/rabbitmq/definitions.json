{
  "users": [
    {
      "name": "bench",
      "password": "bench",
      "tags": "administrator"
    }
  ],
  "vhosts": [
    {
      "name": "bench"
    }
  ],
  "permissions": [
    {
      "user": "bench",
      "vhost": "bench",
      "configure": ".*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "policies": [
    {
      "vhost": "bench",
      "name": "bench-lazy-queues",
      "pattern": "^bench\\.",
      "apply-to": "queues",
      "definition": {
        "queue-mode": "lazy",
        "max-length-bytes": 268435456,
        "overflow": "reject-publish"
      },
      "priority": 0
    }
  ]
}
