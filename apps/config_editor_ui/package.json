{
  "name": "ddl-benchmark-config-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DDL Benchmark Engine — редактор конфигураций бенчмарков (offline SPA)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "check:roundtrip": "esbuild scripts/roundtrip-check.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/roundtrip.mjs && node node_modules/.cache/roundtrip.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
