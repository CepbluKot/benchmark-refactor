# Local M0 values only. Replace every REPLACE_* value before starting.
# Database passwords must be URL-safe because Compose embeds them in connection URLs.
M0_POSTGRES_SUPERUSER_PASSWORD=REPLACE_POSTGRES_SUPERUSER
M0_HATCHET_DATABASE_PASSWORD=REPLACE_HATCHET_DATABASE
M0_PRODUCT_MIGRATOR_PASSWORD=REPLACE_PRODUCT_MIGRATOR
M0_PRODUCT_APP_PASSWORD=REPLACE_PRODUCT_APP
M0_HATCHET_ADMIN_EMAIL=admin@example.invalid
M0_HATCHET_ADMIN_PASSWORD=REPLACE_HATCHET_ADMIN_Strong_123!

M0_CORE_RELEASE_ID=m0-a
M0_PLUGIN_RELEASE_ID=m0-a
M0_ACTIVE_STUDY_LIMIT=100
M0_CONTROL_PORT=18800
M0_HATCHET_UI_PORT=18880
