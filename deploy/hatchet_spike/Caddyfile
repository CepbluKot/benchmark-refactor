:8080 {
    header {
        Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        Referrer-Policy "no-referrer"
        X-Content-Type-Options "nosniff"
    }

    handle /api/* {
        reverse_proxy hatchet-api:8080
    }

    handle {
        reverse_proxy hatchet-frontend:80
    }
}
