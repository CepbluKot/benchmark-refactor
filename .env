# --- ClickHouse Celery Worker settings (src/benchmark_runtime/implementations/clickhouse_celery/settings.py) ---
RABBITMQ_HOSTNAME=localhost
RABBITMQ_LOGIN=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
CELERY_WORKER_CONCURRENCY=2
CLICKHOUSE_MANAGER_MAX_CONCURRENT_STREAMS_PER_PROCESS=1
# CLICKHOUSE_STREAM_SLOT_ACQUIRE_TIMEOUT_SEC=5
MAX_COPY_N_RETRIES=100
MAX_COPY_RETRY_SLEEP_SEC=10
MAX_COPY_RETRY_SLEEP_SEC_INCREMENT=2

# Optional explicit Celery URLs (override RABBITMQ_* if set)
